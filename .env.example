# Lokal ishlab chiqish uchun (docker-compose.yml bilan mos)
DATABASE_URL="postgresql://yoshlik:yoshlik@localhost:5432/yoshlik"

# Admin telefonlari (vergul bilan). Pastdagisi lokal test raqami — haqiqiy 2 ta admin raqamini yozing.
ADMIN_TELEFONLAR="+998900000001"

# Lokal test raqamlari (OTP test rejimida kod server logiga chiqadi):
#   +998900000001 — admin, +998900000002 va +998900000003 — mijozlar

# To'lov: Click/Payme kalitlari hali yo'q — test rejimida "test to'lov" sahifasi ishlaydi.
# Productionda TOLOV_REJIM=test qo'yilmasin.
TOLOV_REJIM="test"

# Yetkazish — VAQTINCHA TEST QIYMATLAR. Haqiqiy kafe koordinatasi va tarifni yozing.
KAFE_LAT="41.311081"
KAFE_LNG="69.240562"
YETKAZISH_BAZAVIY="5000"
YETKAZISH_KM_NARXI="2000"
YETKAZISH_RADIUS_KM="5"
YETKAZISH_MIN_SUMMA="30000"

// S2 — to'liq ma'lumot modeli (PRD, 7-bo'lim).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // Neon: pooled ulanish (ilova uchun)
  directUrl = env("DATABASE_URL_UNPOOLED") // Neon: to'g'ridan-to'g'ri ulanish (migratsiya uchun)
}

model Kategoriya {
  id      Int    @id @default(autoincrement())
  nom     String
  belgi   String // emoji — rasm bo'lmaganda taom kartasida ko'rinadi
  tartib  Int    @default(0)
  taomlar Taom[]
}

model Taom {
  id           Int           @id @default(autoincrement())
  nom          String
  narx         Int // so'mda
  hajm         String? // "1 pors", "0,5 l"
  tavsif       String?
  rasm         String? // rasm URL'i; yuklash S6 (admin)da
  tugadi       Boolean       @default(false)
  tartib       Int           @default(0)
  kategoriyaId Int?
  kategoriya   Kategoriya?   @relation(fields: [kategoriyaId], references: [id])
  qatorlar     ZakazQatori[]
}

enum OlishUsuli {
  ZAL
  OLIB_KETISH
  YETKAZISH
}

// PRD 8-bo'lim. QABUL_QILINDI — naqd yetkazish (to'lanmagan, lekin qabul qilingan).
enum ZakazHolati {
  TOLOV_KUTILMOQDA
  TOLANDI
  QABUL_QILINDI
  TAYYORLANMOQDA
  TAYYOR
  YOLDA
  BERILDI
  BEKOR
}

model Zakaz {
  id              Int           @id @default(autoincrement())
  raqam           Int           @unique @default(autoincrement())
  holat           ZakazHolati   @default(TOLOV_KUTILMOQDA)
  olishUsuli      OlishUsuli
  olishVaqti      String? // "11:20"
  tolovUsuli      TolovUsuli?
  taomlarSumma    Int           @default(0)
  chegirma        Int           @default(0)
  yetkazishNarxi  Int           @default(0)
  jamiSumma       Int // taomlarSumma - chegirma + yetkazishNarxi
  yetkazishManzil String?
  lat             Float?
  lng             Float?
  masofaKm        Float?
  yaratilgan      DateTime      @default(now())
  mijozId         Int?
  mijoz           Mijoz?        @relation(fields: [mijozId], references: [id])
  promokodId      Int?
  promokod        Promokod?     @relation(fields: [promokodId], references: [id])
  manba           ZakazManbasi  @default(ONLAYN) // bot/ilova yoki kassa
  xodimId         Int? // kassada kiritgan xodim
  xodim           Admin?        @relation(fields: [xodimId], references: [id])
  bekorSababi     String? // admin bekor qilganda
  // Chek printeri (kassa kompyuteridagi dastur): bot zakazlari uchun ikki chek. null — hali chiqmagan.
  oshxonaChek     DateTime?
  kassaChek       DateTime?
  qatorlar        ZakazQatori[]
  tolovlar        Tolov[]
}

enum ZakazManbasi {
  ONLAYN
  KASSA
}

// Zakazdagi har bir taom. nom va narx — zakaz paytidagi nusxa (narx keyin o'zgarsa ham saqlanadi).
model ZakazQatori {
  id      Int    @id @default(autoincrement())
  zakazId Int
  zakaz   Zakaz  @relation(fields: [zakazId], references: [id], onDelete: Cascade)
  taomId  Int?
  taom    Taom?  @relation(fields: [taomId], references: [id], onDelete: SetNull)
  nom     String
  narx    Int
  soni    Int
}

model Mijoz {
  id         Int       @id @default(autoincrement())
  telegramId BigInt?   @unique
  ism        String?
  telefon    String?   @unique
  roziVaqti  DateTime? // telefon va zakazlar saqlanishiga rozilik berilgan vaqt
  yaratilgan DateTime  @default(now())
  manzillar  Manzil[]
  zakazlar   Zakaz[]
  sessiyalar Sessiya[]
}

// Bir martalik kirish kodi. Bazada kodning o'zi emas, xeshi saqlanadi.
model OtpKod {
  id         Int      @id @default(autoincrement())
  telefon    String
  kodHash    String
  muddati    DateTime
  urinish    Int      @default(0)
  ishlatildi Boolean  @default(false)
  yaratilgan DateTime @default(now())

  @@index([telefon])
}

// Kompyuterda bot orqali kirish so'rovi: sahifa so'rov ochadi, xodim Telegram'da botda tasdiqlaydi.
// id — t.me havolasidagi ochiq identifikator; sirHash — faqat sahifadagi sirning xeshi (so'rovni faqat o'sha sahifa yakunlaydi).
model BotKirish {
  id          String   @id
  sirHash     String
  telegramId  BigInt?
  mijozId     Int?
  tasdiqlandi Boolean  @default(false)
  ishlatildi  Boolean  @default(false)
  muddati     DateTime
  yaratilgan  DateTime @default(now())

  @@index([telegramId])
}

// Kirish sessiyasi. id — cookie'dagi tokenning xeshi.
model Sessiya {
  id         String   @id
  mijozId    Int
  mijoz      Mijoz    @relation(fields: [mijozId], references: [id], onDelete: Cascade)
  muddati    DateTime
  yaratilgan DateTime @default(now())
}

model Manzil {
  id      Int    @id @default(autoincrement())
  mijozId Int
  mijoz   Mijoz  @relation(fields: [mijozId], references: [id], onDelete: Cascade)
  matn    String
  lat     Float?
  lng     Float?
}

enum TolovUsuli {
  CLICK
  PAYME
  NAQD
  KASSA
  KARTA // kassa terminali
}

enum TolovHolati {
  KUTILMOQDA
  TOLANDI
  BEKOR
  QAYTARILDI
}

model Tolov {
  id         Int         @id @default(autoincrement())
  zakazId    Int
  zakaz      Zakaz       @relation(fields: [zakazId], references: [id])
  usul       TolovUsuli
  summa      Int
  holat      TolovHolati @default(KUTILMOQDA)
  yaratilgan DateTime    @default(now())
}

// Foizli chegirma (DECISIONS.md). Chegirma faqat taomlar summasiga.
model Promokod {
  id           Int       @id @default(autoincrement())
  kod          String    @unique
  foiz         Int       @default(0)
  muddati      DateTime?
  maxIshlatish Int?
  ishlatildi   Int       @default(0)
  faol         Boolean   @default(true)
  yaratilgan   DateTime  @default(now())
  zakazlar     Zakaz[]
}

// Admin telefon raqami bo'yicha aniqlanadi (S3); Telegram ID S6'da ishlatiladi.
// Xodim (jadval nomi tarixiy: Admin). Rol bo'yicha admin panelga kiradi; telefoni orqali mijoz akkauntiga bog'lanadi.
// Vercel'dagi ADMIN_TELEFONLAR — egalar, doim ADMIN (jadvalda bo'lmasa ham).
model Admin {
  id         Int        @id @default(autoincrement())
  telegramId BigInt?    @unique
  telefon    String?    @unique
  ism        String?
  rol        XodimRoli  @default(ADMIN)
  faol       Boolean    @default(true)
  yaratilgan DateTime   @default(now())
  zakazlar   Zakaz[]
  harajatlar Harajat[]
}

enum XodimRoli {
  ADMIN
  KASSIR
  OSHPAZ
}

enum HarajatTurkumi {
  MAHSULOT
  ISH_HAQI
  KOMMUNAL
  IJARA
  BOSHQA
}

model Harajat {
  id         Int            @id @default(autoincrement())
  sana       DateTime // kun (Toshkent kuni boshi)
  summa      Int
  turkum     HarajatTurkumi
  izoh       String?
  xodimId    Int?
  xodim      Admin?         @relation(fields: [xodimId], references: [id], onDelete: SetNull)
  yaratilgan DateTime       @default(now())

  @@index([sana])
}

// Admin paneldan o'zgartiriladigan sozlamalar (bo'sh bo'lsa .env qiymati ishlatiladi).
model Sozlama {
  kalit  String @id
  qiymat String
}
